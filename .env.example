PORT=3000
BASE_URL=https://your-app.onrender.com
NODE_ENV=development

# OpenAI-compatible AI endpoint (Groq, OpenRouter, Together, Ollama, etc.)
AI_API_URL=https://api.groq.com/openai/v1
AI_API_KEY=your_ai_api_key
AI_MODEL=llama-3.3-70b-versatile

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret

# Default timezone for reminders when user does not specify
DEFAULT_TIMEZONE=Asia/Kolkata

# Admin Telegram chat/user id for daily reports (find chatId in customers DB)
# 08:00 health ping + 19:00 EOD stats (timezone = DEFAULT_TIMEZONE)
ADMIN_TELEGRAM_CHAT_ID=1817277135

# MongoDB Atlas (database name RemindMeAI)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=RemindMeAI

# Admin auth (seeded into MongoDB `admins` collection on first boot)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123

# --- Render notes ---
# Set BASE_URL to your permanent HTTPS service URL (no trailing slash).
# Point Telegram webhook to: ${BASE_URL}/telegram/webhook
# PORT is injected by Render — do not hardcode it.
