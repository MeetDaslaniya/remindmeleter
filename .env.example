PORT=5000
BASE_URL=http://localhost:5000
NODE_ENV=development

# OpenAI-compatible AI endpoint (Groq, OpenRouter, Together, Ollama, etc.)
AI_API_URL=https://api.groq.com/openai/v1
AI_API_KEY=your_ai_api_key
AI_MODEL=llama-3.3-70b-versatile

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret

# Default timezone for reminders when user does not specify
DEFAULT_TIMEZONE=Asia/Kolkata

# MongoDB Atlas (database name RemindMeAI)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=RemindMeAI

# Admin auth (seeded into MongoDB `admins` collection on first boot)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123
